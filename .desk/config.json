{
  "version": 1,
  "github": "munhq/gpu-api-ray",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "validation": [
    {
      "name": "go",
      "command": "DESK_BUCK_TOOLCHAIN=\"go $(go version)\" sh .desk/workflows/buck-base/scripts/buck-run.sh build //:check",
      "timeoutMinutes": 15,
      "paths": [
        "**/*.go",
        "go.mod",
        "go.sum",
        "BUCK",
        ".buckconfig",
        ".desk/config.json"
      ]
    }
  ],
  "preLand": [
    "test -z \"$(gofmt -l .)\"",
    "go vet ./..."
  ],
  "checkouts": [
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-base",
      "at": 609,
      "subpath": "workflows/buck-base"
    },
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-node",
      "at": 609,
      "subpath": "workflows/buck-node"
    }
  ]
}
