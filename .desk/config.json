{
  "version": 1,
  "github": "munhq/gpu-api-ray",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "validation": [
    {
      "name": "gofmt",
      "command": "test -z \"$(gofmt -l .)\"",
      "stage": "land",
      "paths": [
        "**/*.go",
        "go.mod"
      ]
    },
    {
      "name": "vet",
      "command": "go vet ./...",
      "stage": "main",
      "paths": [
        "**/*.go",
        "go.mod",
        "go.sum"
      ]
    }
  ],
  "preLand": [
    "test -z \"$(gofmt -l .)\"",
    "go vet ./..."
  ]
}
